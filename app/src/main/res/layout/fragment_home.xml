<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_blue">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/primary_blue"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvHalo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Halo, Adilah 👋"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Saatnya laundry, tinggal klik"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tvHalo"
        app:layout_constraintStart_toStartOf="@id/tvHalo" />

    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="0dp"
        android:layout_height="160dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Banner promo"
        android:scaleType="fitCenter"
        android:src="@drawable/infobannerlaundry"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPilihLayanan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Pilih Layanan"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/imgBanner"
        app:layout_constraintStart_toStartOf="@id/imgBanner" />

    <TextView
        android:id="@+id/lihatSemua"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:padding="8dp"
        android:text="Lihat Semua"
        android:textColor="@color/primary_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBaseline_toBaselineOf="@id/tvPilihLayanan"
        app:layout_constraintEnd_toEndOf="@id/imgBanner" />

    <Button
        android:id="@+id/btncucidansetrika"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/button_layanan"
        android:gravity="center"
        android:text="CUCI DAN SETRIKA"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toBottomOf="@id/tvPilihLayanan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCuciKering" />

    <Button
        android:id="@+id/btnCuciKering"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/button_layanan"
        android:gravity="center"
        android:text="CUCI KERING"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="@id/btncucidansetrika"
        app:layout_constraintStart_toEndOf="@id/btncucidansetrika"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSetrikaSaja"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/button_layanan"
        android:gravity="center"
        android:text="SETRIKA SAJA"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toBottomOf="@id/btncucidansetrika"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnExpress" />

    <Button
        android:id="@+id/btnExpress"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/button_layanan"
        android:gravity="center"
        android:text="EXPRESS"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        app:backgroundTint="@null"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="@id/btnSetrikaSaja"
        app:layout_constraintStart_toEndOf="@id/btnSetrikaSaja"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnWebView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:backgroundTint="@color/navy"
        android:text="TIPS LAUNDRY"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/btnSetrikaSaja"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>