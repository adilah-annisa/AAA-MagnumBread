<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBFF"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleTextColor="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Halo, Adilah! 👋"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="4dp"
                android:text="Saatnya laundry, tinggal klik"
                android:textColor="#DFF4FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- MENU GRID 3 x 2 -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="14dp"
            android:columnCount="3">

            <LinearLayout
                android:id="@+id/btnMenuLayanan"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🧺" android:textSize="26sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Layanan"
                    android:textColor="#102A43" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuPesan"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💬" android:textSize="26sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Pesan"
                    android:textColor="#102A43" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuPesanan"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📋" android:textSize="26sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Pesanan"
                    android:textColor="#102A43" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuJadwal"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🗓️" android:textSize="26sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Jadwal"
                    android:textColor="#102A43" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuTracking"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🚚" android:textSize="26sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Tracking"
                    android:textColor="#102A43" android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMenuBayar"
                android:layout_width="0dp"
                android:layout_height="84dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="💳" android:textSize="26sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" android:text="Bayar"
                    android:textColor="#102A43" android:textSize="12sp" />
            </LinearLayout>
        </GridLayout>

        <!-- BANNER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_banner"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gratis Jemput &amp; Antar!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Untuk pemesanan pertama"
                android:textColor="#DFF4FF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- PILIH LAYANAN -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pilih Layanan"
                android:textColor="#102A43"
                android:textSize="18sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/lihatSemua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:text="Lihat Semua"
                android:textColor="#1677E8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- GRID LAYANAN 2 x 2 -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="14dp"
            android:columnCount="2">

            <TextView
                android:id="@+id/btncucidansetrika"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Cuci &amp; Setrika"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCuciKering"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Cuci Kering"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSetrikaSaja"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Setrika Saja"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExpress"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:background="@drawable/bg_card"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Express"
                android:textColor="#102A43"
                android:textSize="14sp"
                android:textStyle="bold" />
        </GridLayout>

        <!-- WEBVIEW -->
        <TextView
            android:id="@+id/btnWebView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="Kunjungi Website Laundry Express"
            android:textColor="#1677E8"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>