<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FAFC"
    tools:context=".MainActivity"
    tools:layout_editor_absoluteX="16dp"
    tools:layout_editor_absoluteY="52dp">


    <android.widget.Button
        android:id="@+id/btncucidansetrika"
        android:layout_width="173dp"
        android:layout_height="138dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/button_layanan"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_bold"
        android:text="Cuci dan Setrika"
        android:textColor="#102A43"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="282dp" />

    <android.widget.Button
        android:id="@+id/btnCuciKering"
        android:layout_width="173dp"
        android:layout_height="138dp"
        android:layout_marginStart="204dp"
        android:background="@drawable/button_layanan"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_bold"
        android:text="Cuci kering"
        android:textColor="#102A43"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="282dp" />

    <android.widget.Button
        android:id="@+id/btnExpress"
        android:layout_width="173dp"
        android:layout_height="138dp"
        android:layout_marginStart="204dp"
        android:background="@drawable/button_layanan"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_semibold"
        android:text="Express"
        android:textColor="#102A43"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="436dp" />

    <android.widget.Button
        android:id="@+id/btnSetrikaSaja"
        android:layout_width="173dp"
        android:layout_height="138dp"
        android:layout_marginStart="20dp"
        android:background="@drawable/button_layanan"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_semibold"
        android:text="Setrika Saja"
        android:textColor="#102A43"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="436dp" />

    <ImageView
        android:id="@+id/imgBanner"
        android:layout_width="408dp"
        android:layout_height="132dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="Gratis Jemput dan Antar"
        android:scaleType="fitCenter"
        android:src="@drawable/infobannerlaundry"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.517"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/description" />

    <TextView
        android:id="@+id/greetings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Halo, Adilah👋"
        android:textSize="20sp"
        android:textColor="#102A43"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.052"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/pilihlayanan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="236dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Pilih Layanan"
        android:textColor="#102A43"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.065"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/lihatsemua"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="244dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Lihat Semua"
        android:textColor="#1677E8"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="Saatnya laundry, tinggal klik"
        android:textColor="#6B7C93"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.082"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="59dp" />

    <Button
        android:id="@+id/btnToWebView"
        android:layout_width="358dp"
        android:layout_height="62dp"
        android:layout_marginTop="26dp"
        android:backgroundTint="#0B2D5C"
        android:text="Pergi Ke WebView"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSetrikaSaja" />


</androidx.constraintlayout.widget.ConstraintLayout>